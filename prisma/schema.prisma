// Prisma schema for LudoStar BD (PostgreSQL / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  WAITING
  RUNNING
  COMPLETED
  DISPUTED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  MATCH_FEE
  MATCH_WIN
  REFERRAL_BONUS
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MfsProvider {
  BKASH
  NAGAD
  ROCKET
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  firstName    String
  lastName     String   @default("")
  role         Role     @default(USER)
  mainBalance  Float    @default(0)
  winBalance   Float    @default(0)
  referCode    String   @unique
  referredBy   String?
  avatar       String?
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions  Transaction[]

  @@index([phone])
  @@index([referCode])
}

model Match {
  id             String      @id @default(uuid())
  matchNo        Int         @unique @default(autoincrement())
  title          String      @default("১ বনাম ১ ক্লাসিক ম্যাচ")
  entryFee       Float
  prize          Float
  matchType      String      @default("1v1 Classic")
  status         MatchStatus @default(WAITING)
  maxPlayers     Int         @default(2)
  roomCode       String?

  // Players stored as JSON array
  players        Json?       @default("[]")

  // Creator (nullable — admin can create open matches)
  creatorId      String?
  creatorPhone   String?
  creatorName    String?

  // Opponent
  opponentId     String?
  opponentPhone  String?
  opponentName   String?

  // Winner
  winnerId       String?
  winnerName     String?

  // Results
  creatorResult    String?
  opponentResult   String?
  creatorProofUrl  String?
  opponentProofUrl String?
  disputeReason    String?
  adminNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([creatorId])
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  userName      String?
  userPhone     String?
  type          TransactionType
  amount        Float
  status        TransactionStatus @default(PENDING)
  mfsProvider   MfsProvider?
  accountType   String?           @default("Personal")
  accountNumber String?
  trxId         String?
  adminTrxId    String?
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([trxId])
}

model Notice {
  id        String   @id @default(uuid())
  text      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // User ID or "ALL"
  title       String
  message     String
  type        String   @default("SYSTEM")
  link        String?
  isRead      Boolean  @default(false)
  readByUsers String[] @default([])
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ReceivedSms {
  id          String      @id @default(uuid())
  trxId       String      @unique
  mfsProvider MfsProvider
  amount      Float
  senderPhone String?
  rawMessage  String
  isClaimed   Boolean     @default(false)
  claimedBy   String?
  claimedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([trxId])
  @@index([isClaimed])
}
